// AnyDL - download whatever a link points to, and edit videos and photos.
// The downloader itself is anydl.py, embedded below as base64 by build.py
// and run inside the a-Shell app. The media tools use iOS's own actions.
//
// build.py also fills in:
//   ,    embedded files
//   3.3, 3003      "3.0" and 3000, from anydl.py
//   @@CARD(title | subtitle | icon name)@@  a menu row: a vCard with an icon from
//                                      icons/<icon>.png; the subtitle may
//                                      contain {@variables}

#define name AnyDL
#define color blue
#define glyph circledDownArrow
#define inputs url, text, webpage, image, media, file
#define from sharesheet
#define noinput getclipboard

#include 'actions/web'
#include 'actions/text'
#include 'actions/crypto'
#include 'actions/documents'
#include 'actions/media'
#include 'actions/images'
#include 'actions/photos'
#include 'actions/sharing'

// Keep a blank line after each definition: the compiler swallows the next line otherwise.
action 'AsheKube.app.a-Shell.ExecuteCommandIntent' aShellRun(text command: 'command', text openWindow: 'openWindow', bool keepGoing: 'keepGoing') {
    "ShowWhenRun": false
}

action 'AsheKube.app.a-Shell.PutFileIntent' aShellPut(variable file: 'file', bool overwrite: 'overwrite') {
    "ShowWhenRun": false
}

action 'AsheKube.app.a-Shell.GetFileIntent' aShellGet(text fileName: 'fileName', bool errorIfNotFound: 'errorIfNotFound', bool copyFile: 'copyFile'): variable {
    "ShowWhenRun": false
}

// Get Details of Files. Cherri's own getFileDetail() passes the file as
// WFFolder; real shortcuts use WFInput.
action 'properties.files' fileDetailOf(variable file: 'WFInput', text detail: 'WFContentItemPropertyName')

// Select Photos, limited to videos or to photos, so a tool never gets the
// wrong kind (Encode Media cannot take a photo).
action 'selectphoto' pickVideoFromPhotos(): variable {
    "WFPhotoPickerTypes": "Videos"
}

action 'selectphoto' pickImageFromPhotos(): variable {
    "WFPhotoPickerTypes": "Images"
}

// Encode Media at HEVC 4K. Cherri's size list spells it "3840x2160" with a
// plain x, which Shortcuts does not know; Shortcuts uses ×.
action 'encodemedia' encodeVideoHEVC4K(variable video: 'WFMedia') {
    "WFMediaSize": "HEVC 3840×2160"
}

/* AnyDL runs in two halves and never waits for a-Shell, so it can never be
   left running in the background:
   - Started normally, it shows the menu; a download starts a-Shell and ends.
   - a-Shell shows a single download in its own preview. Only when there is
     something to show here (a choice, a summary, an error, several files,
     saving to Photos) does the script start AnyDL again, with the text
     anydl-return as input. */

/* ------------------------------------------------ Second half: results. */
@input = "{ShortcutInput}"
if @input contains "anydl-return" {
    const statusFile = aShellGet("anydl_status.txt", true, true)
    @status = "{statusFile}"
    if @status == "PICK" {
        /* Several items on the page: pick here, then run the downloader again. */
        const choicesFile = aShellGet("anydl_choices.txt", true, true)
        // The separator is spelled out on purpose: leaving it at the default breaks the build.
        const options = splitText("{choicesFile}", "\n")
        const picked = chooseFromList(options, "Choose what to download", true)
        const pickText = "pick\n{picked}"
        const pickFile = setName(pickText, "anydl_job.txt", true)
        aShellPut(pickFile, true)
        aShellRun("cd $SHORTCUTS\npython anydl.py", "open", false)
        stop()
    }
    if @status == "PLAYLIST" {
        /* A playlist, channel or profile: all, or a typed amount. */
        const askFile = aShellGet("anydl_message.txt", true, true)
        const amountsFile = aShellGet("anydl_choices.txt", true, true)
        const amounts = splitText("{amountsFile}", "\n")
        const amountPicked = chooseFromList(amounts, "{askFile}")
        @amount = "{amountPicked}"
        if @amount contains "Choose" {
            const numberFile = aShellGet("anydl_number.txt", true, true)
            @amount = prompt("{numberFile}", "Number")
        }
        const amountText = "playlist\n{@amount}"
        const amountFile = setName(amountText, "anydl_job.txt", true)
        aShellPut(amountFile, true)
        aShellRun("cd $SHORTCUTS\npython anydl.py", "open", false)
        stop()
    }
    if @status == "SAVED" {
        /* A playlist was saved to a folder in the Files app. */
        const savedFile = aShellGet("anydl_message.txt", true, true)
        const folderFile = aShellGet("anydl_open.txt", true, true)
        @folderLink = "{folderFile}"
        menu "{savedFile}" {
            item "Open in Files":
                openURL(@folderLink)
            item "Done":
                nothing()
        }
        stop()
    }
    if @status == "PHOTOS" {
        /* After download: Save to Photos. The script only asks for this for
           photos and videos small enough to fetch from a-Shell. */
        const photoList = aShellGet("anydl_files.txt", true, true)
        const photoNames = splitText("{photoList}", "\n")
        @savedCount = 0
        for photoName in photoNames {
            const photoFile = aShellGet("{@photoName}", true, true)
            savePhoto(photoFile)
            @savedCount += 1
        }
        showNotification("Saved {@savedCount} to Photos. Also in Files › a-Shell › AnyDL.", "AnyDL")
        stop()
    }
    if @status == "CLEARED" {
        /* Settings › Clear downloads: say what was deleted, then the menu. */
        const clearedFile = aShellGet("anydl_message.txt", true, true)
        alert("{clearedFile}", "Clear downloads")
    } else {
        if @status == "OK" {
            /* Several files: preview them here, where you can swipe through them. */
            const listFile = aShellGet("anydl_files.txt", true, true)
            const names = splitText("{listFile}", "\n")
            const downloads = for fileName in names {
                aShellGet("{@fileName}", true, true)
            }
            quicklook(downloads)
            stop()
        }
        /* An error: say what went wrong, then the menu, so AnyDL stays
           usable. */
        alert("{@status}", "AnyDL")
    }
}

/* ------------------------------------------------ First run: welcome. */
/* A welcome page with the setup steps, shown before anything needs a-Shell,
   so someone without it is told to install it. The flag lives in the
   Shortcuts folder for the same reason. */
const welcomeText = ""
const welcomeData = base64Decode(welcomeText)
const welcomePage = setName(welcomeData, "Welcome to AnyDL.html", true)
const welcomeFlag = getFile("AnyDL/welcome.txt", nil, false)
@welcomed = "{welcomeFlag}"
if !@welcomed {
    quicklook(welcomePage)
    menu "Ready to start?" {
        item "I have a-Shell, let's go":
            const flagText = "Welcome shown. Delete this file to see it again."
            saveFile("AnyDL/welcome.txt", flagText, true)
        item "Get a-Shell from the App Store":
            openURL("https://apps.apple.com/app/a-shell/id1473805438")
            stop()
        item "Open the setup guide":
            openURL("https://github.com/h4sw5q2wr9-byte/AnyDL#set-up")
            stop()
    }
}

/* ------------------------------------------------ Settings. */
/* Saved in a-Shell as key=value lines. Values are stored as shown, and the
   downloader reads them too. The defaults follow the saved ones, so the
   first match is the saved value when there is one. */
const settingsFile = aShellGet("anydl_settings.txt", false, true)
@settings = "{settingsFile}"
@withDefaults = "{@settings}\nquality=Best\nfps=Any\ncodec=Most compatible\naudio=Original\nsubtitles=Off\nafter=Preview\nkeep=Forever\nupdates=On"
const qualityFound = matchText('quality=[^\n]*', "{@withDefaults}")
const qualityLine = getFirstItem(qualityFound)
@quality = replaceText("quality=", "", "{qualityLine}")
const fpsFound = matchText('fps=[^\n]*', "{@withDefaults}")
const fpsLine = getFirstItem(fpsFound)
@fps = replaceText("fps=", "", "{fpsLine}")
const codecFound = matchText('codec=[^\n]*', "{@withDefaults}")
const codecLine = getFirstItem(codecFound)
@codec = replaceText("codec=", "", "{codecLine}")
const audioFound = matchText('audio=[^\n]*', "{@withDefaults}")
const audioLine = getFirstItem(audioFound)
@audio = replaceText("audio=", "", "{audioLine}")
const subtitlesFound = matchText('subtitles=[^\n]*', "{@withDefaults}")
const subtitlesLine = getFirstItem(subtitlesFound)
@subtitles = replaceText("subtitles=", "", "{subtitlesLine}")
const afterFound = matchText('after=[^\n]*', "{@withDefaults}")
const afterLine = getFirstItem(afterFound)
@after = replaceText("after=", "", "{afterLine}")
const keepFound = matchText('keep=[^\n]*', "{@withDefaults}")
const keepLine = getFirstItem(keepFound)
@keep = replaceText("keep=", "", "{keepLine}")
const updatesFound = matchText('updates=[^\n]*', "{@withDefaults}")
const updatesLine = getFirstItem(updatesFound)
@updates = replaceText("updates=", "", "{updatesLine}")

/* A newer version found by the downloader's daily check, offered once. */
const updateFile = aShellGet("anydl_update.txt", false, true)
@update = "{updateFile}"
if @update contains "." {
    const seenText = "seen"
    const seenFile = setName(seenText, "anydl_update.txt", true)
    aShellPut(seenFile, true)
    menu "AnyDL {@update} is available (you have 3.3)" {
        item "Update now":
            openURL("https://github.com/h4sw5q2wr9-byte/AnyDL/releases/latest")
            stop()
        item "Later":
            nothing()
    }
}

/* ------------------------------------------------ What was shared. */
/* A link (shared, or on the clipboard) opens the download menu. A photo,
   video or audio file shared to AnyDL opens the matching media tools. */
@shared
@sharedKind = ""
@view = "home"
@link = ""
@videoTypes = "mov mp4 m4v 3gp avi mkv webm hevc"
@photoTypes = "heic heif jpg jpeg png gif webp tiff tif bmp dng avif"
@audioTypes = "m4a mp3 wav aac aiff aif caf flac ogg opus"
/* Only web links count. A video shared from Photos reads as a link too:
   as its file, file:///…/IMG_1234.MOV, or as its name, IMG_1234.MOV,
   which looks like a web address because .mov is a web domain. */
if @input !contains "anydl-return" {
    const found = getURLs("{ShortcutInput}")
    @link = getFirstItem(found)
    const webLinkFound = matchText('(?i)^https?://', "{@link}")
    if !webLinkFound {
        @link = ""
    }
    const fileNameFound = matchText('(?i)^(https?://)?[^/]+\.(mov|mp4|m4v|3gp|avi|mkv|webm|hevc|heic|heif|jpg|jpeg|png|gif|webp|tiff|tif|bmp|dng|avif|m4a|mp3|wav|aac|aiff|aif|caf|flac|ogg|opus|pdf|zip)/?$', "{@link}")
    if fileNameFound {
        @link = ""
    }
    /* No link: a shared photo, video or audio file opens its tools. The
       file extension says which; when there is none, Media tools asks. */
    if !@link {
        if ShortcutInput {
            const inputKind = typeOf(ShortcutInput)
            @kind = "{inputKind}"
            @firstShared = getFirstItem(ShortcutInput)
            const sharedExtension = fileDetailOf(@firstShared, "File Extension")
            @extension = lowercase("{sharedExtension}")
            if @extension {
                if @videoTypes contains @extension {
                    @sharedKind = "video"
                }
                if @photoTypes contains @extension {
                    @sharedKind = "photo"
                }
                if @audioTypes contains @extension {
                    @sharedKind = "audio"
                }
            }
            if !@sharedKind {
                if @kind contains "Image" || @kind contains "Media" || @kind contains "Photo" || @kind contains "File" || @kind contains "PDF" {
                    if @extension {
                        alert("AnyDL can download links and edit videos, photos and audio. This is a .{@extension} file ({@kind}), which it cannot open.", "AnyDL")
                    } else {
                        @sharedKind = "ask"
                    }
                }
            }
            if @sharedKind {
                @shared = @firstShared
                @view = "tools"
            }
        }
    }
}
@heading = "AnyDL"
if @link {
    const site = getURLDetail("{@link}", "Host")
    @heading = "Download from {site}"
}

/* The downloader script, put into a-Shell before each a-Shell job. */
const scriptText = ""
const scriptData = base64Decode(scriptText)
const scriptFile = setName(scriptData, "anydl.py", true)

/* ------------------------------------------------ Menus. */
/* One loop, one menu at a time: @view names the menu to show, and every
   submenu has Back. Starting a download or opening Files ends the
   shortcut. Menus are vCards so each row has an icon and a subtitle. */
@mode = ""
@libraryLoaded = false
repeat round for 60 {

    /* -------------------------------------------- Home. */
    if @view == "home" {
        @homeItems: array
        if @link {
            @homeItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Video\nORG:Videos, clips and GIFs\nPHOTO;ENCODING=b:\nEND:VCARD"
            @homeItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Audio\nORG:Music, or the sound of a video\nPHOTO;ENCODING=b:\nEND:VCARD"
            @homeItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Images\nORG:Photos, albums and image posts\nPHOTO;ENCODING=b:\nEND:VCARD"
            @homeItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:File\nORG:Documents, archives, anything linked\nPHOTO;ENCODING=b:\nEND:VCARD"
            @homeItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:More\nORG:Media tools, my downloads, settings\nPHOTO;ENCODING=b:\nEND:VCARD"
        } else {
            @homeItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Download a link\nORG:Paste a link to a video, song or file\nPHOTO;ENCODING=b:\nEND:VCARD"
            @homeItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Media tools\nORG:Edit videos, photos and audio\nPHOTO;ENCODING=b:\nEND:VCARD"
            @homeItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:My downloads\nORG:Recent downloads and your folders\nPHOTO;ENCODING=b:\nEND:VCARD"
            @homeItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Settings\nORG:Quality, subtitles, storage and more\nPHOTO;ENCODING=b:\nEND:VCARD"
        }
        @homeText = "{@homeItems}"
        @homeFile = setName(@homeText, "home.vcf", true)
        @homeCards = @homeFile.contact
        const homeChoice = chooseFromList(@homeCards, @heading)
        @menuPick = "{homeChoice}"
        if @menuPick == "Video" {
            @mode = "video"
        }
        if @menuPick == "Audio" {
            @mode = "audio"
        }
        if @menuPick == "Images" {
            @mode = "gallery"
        }
        if @menuPick == "File" {
            @mode = "file"
        }
        if @menuPick == "More" {
            @view = "more"
        }
        if @menuPick == "Download a link" {
            const pasted = prompt("Paste the link to download", "URL")
            const pastedLinks = getURLs("{pasted}")
            @link = getFirstItem(pastedLinks)
            const pastedWebLink = matchText('(?i)^https?://', "{@link}")
            if pastedWebLink {
                const pastedSite = getURLDetail("{@link}", "Host")
                @heading = "Download from {pastedSite}"
            } else {
                @link = ""
                alert("That is not a web link. Copy the link from the app's Share › Copy link, then try again.", "Download a link")
            }
        }
        if @menuPick == "Media tools" {
            @view = "tools"
        }
        if @menuPick == "My downloads" {
            @view = "library"
        }
        if @menuPick == "Settings" {
            @view = "settings"
        }
    }

    if @view == "more" {
        @moreItems: array
        @moreItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Media tools\nORG:Edit videos, photos and audio\nPHOTO;ENCODING=b:\nEND:VCARD"
        @moreItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:My downloads\nORG:Recent downloads and your folders\nPHOTO;ENCODING=b:\nEND:VCARD"
        @moreItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Settings\nORG:Quality, subtitles, storage and more\nPHOTO;ENCODING=b:\nEND:VCARD"
        @moreItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Back\nORG:To the download menu\nPHOTO;ENCODING=b:\nEND:VCARD"
        @moreText = "{@moreItems}"
        @moreFile = setName(@moreText, "more.vcf", true)
        @moreCards = @moreFile.contact
        const moreChoice = chooseFromList(@moreCards, "More")
        @menuPick = "{moreChoice}"
        @view = "home"
        if @menuPick == "Media tools" {
            @view = "tools"
        }
        if @menuPick == "My downloads" {
            @view = "library"
        }
        if @menuPick == "Settings" {
            @view = "settings"
        }
    }

    /* -------------------------------------------- Download. */
    if @mode {
        /* Video quality for this download, when the setting says to ask. */
        @extra = ""
        if @mode == "video" {
            if @quality == "Ask each time" {
                @askQualities = list("Best", "4K (2160p)", "1440p", "1080p", "720p", "480p", "360p (Data saver)", "240p")
                @pickedQuality = chooseFromList(@askQualities, "Video quality")
                @extra = "quality={@pickedQuality}"
            }
        }
        /* Hand the downloader script and the job to a-Shell, and start it.
           This shortcut ends here; a-Shell shows the result, or starts
           AnyDL again when it needs to. */
        aShellPut(scriptFile, true)
        const jobText = "{@mode}\n{@link}\n{@settings}\n{@extra}"
        const jobFile = setName(jobText, "anydl_job.txt", true)
        aShellPut(jobFile, true)
        aShellRun("cd $SHORTCUTS\npython anydl.py", "open", false)
        stop()
    }

    /* -------------------------------------------- Media tools. */
    /* iOS's own actions: fast, no a-Shell. A shared file is sorted by its
       file extension, so each tool only ever gets the kind it can handle. */
    if @view == "tools" {
        if @shared {
            if @sharedKind == "video" {
                @view = "tools-video"
            }
            if @sharedKind == "photo" {
                @view = "tools-photo"
            }
            if @sharedKind == "audio" {
                @view = "tools-audio"
            }
        }
    }
    if @view == "tools" {
        @toolItems: array
        @toolItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Video tools\nORG:Compress, trim, speed, rotate, GIF, audio\nPHOTO;ENCODING=b:\nEND:VCARD"
        @toolItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Photo tools\nORG:Compress, resize, convert, background, privacy\nPHOTO;ENCODING=b:\nEND:VCARD"
        @toolItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Audio tools\nORG:Trim, convert, speed\nPHOTO;ENCODING=b:\nEND:VCARD"
        @toolItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Back\nORG:To the main menu\nPHOTO;ENCODING=b:\nEND:VCARD"
        @toolText = "{@toolItems}"
        @toolFile = setName(@toolText, "tools.vcf", true)
        @toolCards = @toolFile.contact
        const toolsChoice = chooseFromList(@toolCards, "Media tools")
        @menuPick = "{toolsChoice}"
        @view = "home"
        @pickedKind = ""
        if @menuPick == "Video tools" {
            @view = "tools-video"
            @pickedKind = "video"
        }
        if @menuPick == "Photo tools" {
            @view = "tools-photo"
            @pickedKind = "photo"
        }
        if @menuPick == "Audio tools" {
            @view = "tools-audio"
            @pickedKind = "audio"
        }
        /* A shared file of unknown kind goes to the tools picked here. */
        if @sharedKind == "ask" {
            @sharedKind = @pickedKind
        } else {
            @shared = nil
            @sharedKind = ""
        }
    }

    @result = nil
    @resultKind = ""

    /* Video tools. */
    if @view == "tools-video" {
        @videoItems: array
        @videoItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Compress video\nORG:Make it smaller to share or save space\nPHOTO;ENCODING=b:\nEND:VCARD"
        @videoItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Trim\nORG:Cut it shorter\nPHOTO;ENCODING=b:\nEND:VCARD"
        @videoItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Change speed\nORG:Slow motion or double speed\nPHOTO;ENCODING=b:\nEND:VCARD"
        @videoItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Rotate\nORG:Turn it a quarter or half turn\nPHOTO;ENCODING=b:\nEND:VCARD"
        @videoItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Make a GIF\nORG:An animated GIF from the video\nPHOTO;ENCODING=b:\nEND:VCARD"
        @videoItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Extract audio\nORG:Save its sound as M4A\nPHOTO;ENCODING=b:\nEND:VCARD"
        @videoItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Back\nORG:To Media tools\nPHOTO;ENCODING=b:\nEND:VCARD"
        @videoText = "{@videoItems}"
        @videoMenuFile = setName(@videoText, "video-tools.vcf", true)
        @videoCards = @videoMenuFile.contact
        const videoChoice = chooseFromList(@videoCards, "Video tools")
        @tool = "{videoChoice}"
        if @tool == "Back" {
            @view = "tools"
            @shared = nil
            @sharedKind = ""
        } else {
            @media = nil
            if @sharedKind == "video" {
                @media = @shared
            } else {
                menu "Which video?" {
                    item "Choose from Photos":
                        @media = pickVideoFromPhotos()
                    item "Choose from Files":
                        @media = selectFile()
                    item "Latest video in Photos":
                        @media = getLatestVideos(1)
                }
            }
            const videoExtension = fileDetailOf(@media, "File Extension")
            @extension = lowercase("{videoExtension}")
            @wrongKind = false
            if @extension {
                if @videoTypes !contains @extension {
                    @wrongKind = true
                }
            }
            if @wrongKind == true {
                alert("That file is not a video (.{@extension}). Choose a video, or use Photo tools or Audio tools.", "Video tools")
            } else {
                const videoSizeBefore = fileDetailOf(@media, "File Size")
                @sizeBefore = "{videoSizeBefore}"
                @resultKind = "video"
                if @tool == "Compress video" {
                    @compressions = list("Small · 540p, the smallest file", "Medium · 720p, good for sharing", "HEVC · same 1080p, about half the size", "Large · 1080p, for 4K videos", "HEVC 4K · for 4K videos")
                    const compressPicked = chooseFromList(@compressions, "Compress (now {@sizeBefore}). A lower resolution saves the most; HEVC keeps the resolution.")
                    @compression = "{compressPicked}"
                    showNotification("Compressing… the result opens when it is done.", "AnyDL", false)
                    if @compression contains "HEVC 4K" {
                        @result = encodeVideoHEVC4K(@media)
                    }
                    if @compression contains "HEVC · same 1080p" {
                        @result = encodeVideo(@media, "HEVC 1920×1080")
                    }
                    if @compression contains "Small" {
                        @result = encodeVideo(@media, "960×540")
                    }
                    if @compression contains "Medium" {
                        @result = encodeVideo(@media, "1280×720")
                    }
                    if @compression contains "Large" {
                        @result = encodeVideo(@media, "1920×1080")
                    }
                }
                if @tool == "Trim" {
                    @result = trimVideo(@media)
                }
                if @tool == "Change speed" {
                    @speeds = list("Half speed · slow motion", "Double speed")
                    const speedPicked = chooseFromList(@speeds, "Change speed")
                    @speed = "{speedPicked}"
                    showNotification("Changing the speed… the result opens when it is done.", "AnyDL", false)
                    if @speed contains "Half" {
                        @result = encodeVideo(@media, nil, "0.5X")
                    } else {
                        @result = encodeVideo(@media, nil, "2X")
                    }
                }
                if @tool == "Rotate" {
                    @turns = list("Turn right", "Turn left", "Upside down")
                    const turnPicked = chooseFromList(@turns, "Rotate")
                    @turn = "{turnPicked}"
                    if @turn == "Turn right" {
                        @result = rotateMedia(@media, "90")
                    }
                    if @turn == "Turn left" {
                        @result = rotateMedia(@media, "270")
                    }
                    if @turn == "Upside down" {
                        @result = rotateMedia(@media, "180")
                    }
                }
                if @tool == "Make a GIF" {
                    showNotification("Making the GIF… the result opens when it is done.", "AnyDL", false)
                    @result = makeGIF(@media)
                    @resultKind = "photo"
                }
                if @tool == "Extract audio" {
                    showNotification("Extracting the audio…", "AnyDL", false)
                    @result = encodeAudio(@media, "M4A")
                    @resultKind = "audio"
                }
            }
        }
    }

    /* Photo tools. */
    if @view == "tools-photo" {
        @photoItems: array
        @photoItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Compress photo\nORG:Make it smaller to share or save space\nPHOTO;ENCODING=b:\nEND:VCARD"
        @photoItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Resize\nORG:Fewer pixels: 1080 px, 2048 px, half, quarter\nPHOTO;ENCODING=b:\nEND:VCARD"
        @photoItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Convert\nORG:To JPEG, PNG or HEIF\nPHOTO;ENCODING=b:\nEND:VCARD"
        @photoItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Remove background\nORG:Keep only the subject\nPHOTO;ENCODING=b:\nEND:VCARD"
        @photoItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Remove location & info\nORG:Strip where and how it was taken\nPHOTO;ENCODING=b:\nEND:VCARD"
        @photoItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Rotate or flip\nORG:Turn or mirror it\nPHOTO;ENCODING=b:\nEND:VCARD"
        @photoItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Back\nORG:To Media tools\nPHOTO;ENCODING=b:\nEND:VCARD"
        @photoText = "{@photoItems}"
        @photoMenuFile = setName(@photoText, "photo-tools.vcf", true)
        @photoCards = @photoMenuFile.contact
        const photoChoice = chooseFromList(@photoCards, "Photo tools")
        @tool = "{photoChoice}"
        if @tool == "Back" {
            @view = "tools"
            @shared = nil
            @sharedKind = ""
        } else {
            @media = nil
            if @sharedKind == "photo" {
                @media = @shared
            } else {
                menu "Which photo?" {
                    item "Choose from Photos":
                        @media = pickImageFromPhotos()
                    item "Choose from Files":
                        @media = selectFile()
                    item "Latest photo":
                        @media = getLatestPhotos(1, false)
                }
            }
            const photoExtension = fileDetailOf(@media, "File Extension")
            @extension = lowercase("{photoExtension}")
            @wrongKind = false
            if @extension {
                if @photoTypes !contains @extension {
                    @wrongKind = true
                }
            }
            if @wrongKind == true {
                alert("That file is not a photo (.{@extension}). Choose a photo, or use Video tools or Audio tools.", "Photo tools")
            } else {
                const photoSizeBefore = fileDetailOf(@media, "File Size")
                @sizeBefore = "{photoSizeBefore}"
                @resultKind = "photo"
                /* The longest side, to never make a photo bigger. */
                const photoWidth = getImageDetail(@media, "Width")
                const photoHeight = getImageDetail(@media, "Height")
                @longest = number(photoWidth)
                const heightNumber = number(photoHeight)
                if heightNumber > @longest {
                    @longest = number(photoHeight)
                }
                if @tool == "Compress photo" {
                    @photoSizes = list("Small · 1280 px, JPEG", "Medium · 2048 px, JPEG", "Full size · JPEG", "Full size · HEIF, the smallest file")
                    const photoSizePicked = chooseFromList(@photoSizes, "Compress (now {@sizeBefore}, {@longest} px on the longest side)")
                    @photoSize = "{photoSizePicked}"
                    @scaled = @media
                    if @photoSize contains "1280" {
                        if @longest > 1280 {
                            @scaled = resizeImageByLongestEdge(@media, "1280")
                        }
                    }
                    if @photoSize contains "2048" {
                        if @longest > 2048 {
                            @scaled = resizeImageByLongestEdge(@media, "2048")
                        }
                    }
                    if @photoSize contains "HEIF" {
                        @result = convertImage(@scaled, "HEIF", 0.7)
                    } else {
                        @result = convertToJPEG(@scaled, 0.7)
                    }
                }
                if @tool == "Resize" {
                    @resizes = list("1080 px on the longest side", "2048 px on the longest side", "Half size", "Quarter size")
                    const resizePicked = chooseFromList(@resizes, "Resize (now {@longest} px on the longest side)")
                    @resizeTo = "{resizePicked}"
                    if @resizeTo contains "1080" {
                        @result = resizeImageByLongestEdge(@media, "1080")
                    }
                    if @resizeTo contains "2048" {
                        @result = resizeImageByLongestEdge(@media, "2048")
                    }
                    if @resizeTo == "Half size" {
                        @result = resizeImageByPercent(@media, "50")
                    }
                    if @resizeTo == "Quarter size" {
                        @result = resizeImageByPercent(@media, "25")
                    }
                }
                if @tool == "Convert" {
                    @imageFormats = list("JPEG", "PNG", "HEIF")
                    const formatPicked = chooseFromList(@imageFormats, "Convert to")
                    @imageFormat = "{formatPicked}"
                    if @imageFormat == "JPEG" {
                        @result = convertToJPEG(@media, 0.9)
                    }
                    if @imageFormat == "PNG" {
                        @result = convertImage(@media, "PNG")
                    }
                    if @imageFormat == "HEIF" {
                        @result = convertImage(@media, "HEIF", 0.9)
                    }
                }
                if @tool == "Remove background" {
                    showNotification("Removing the background…", "AnyDL", false)
                    @result = removeBackground(@media, true)
                }
                if @tool == "Remove location & info" {
                    @result = stripImageMetadata(@media)
                }
                if @tool == "Rotate or flip" {
                    @flips = list("Turn right", "Turn left", "Upside down", "Mirror left to right", "Mirror top to bottom")
                    const flipPicked = chooseFromList(@flips, "Rotate or flip")
                    @flip = "{flipPicked}"
                    if @flip == "Turn right" {
                        @result = rotateMedia(@media, "90")
                    }
                    if @flip == "Turn left" {
                        @result = rotateMedia(@media, "270")
                    }
                    if @flip == "Upside down" {
                        @result = rotateMedia(@media, "180")
                    }
                    if @flip == "Mirror left to right" {
                        @result = flipImage(@media, "Horizontal")
                    }
                    if @flip == "Mirror top to bottom" {
                        @result = flipImage(@media, "Vertical")
                    }
                }
            }
        }
    }

    /* Audio tools. */
    if @view == "tools-audio" {
        @audioItems: array
        @audioItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Trim\nORG:Cut a song or recording shorter\nPHOTO;ENCODING=b:\nEND:VCARD"
        @audioItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Convert\nORG:To M4A or AIFF\nPHOTO;ENCODING=b:\nEND:VCARD"
        @audioItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Change speed\nORG:Half or double speed\nPHOTO;ENCODING=b:\nEND:VCARD"
        @audioItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Back\nORG:To Media tools\nPHOTO;ENCODING=b:\nEND:VCARD"
        @audioText = "{@audioItems}"
        @audioMenuFile = setName(@audioText, "audio-tools.vcf", true)
        @audioCards = @audioMenuFile.contact
        const audioChoice = chooseFromList(@audioCards, "Audio tools")
        @tool = "{audioChoice}"
        if @tool == "Back" {
            @view = "tools"
            @shared = nil
            @sharedKind = ""
        } else {
            @media = nil
            if @sharedKind == "audio" {
                @media = @shared
            } else {
                menu "Which audio?" {
                    item "Choose from Files":
                        @media = selectFile()
                    item "The sound of a video in Photos":
                        const soundVideo = pickVideoFromPhotos()
                        showNotification("Getting the sound…", "AnyDL", false)
                        @media = encodeAudio(soundVideo, "M4A")
                }
            }
            const audioExtension = fileDetailOf(@media, "File Extension")
            @extension = lowercase("{audioExtension}")
            @wrongKind = false
            if @extension {
                if @audioTypes !contains @extension {
                    @wrongKind = true
                }
            }
            if @wrongKind == true {
                alert("That file is not audio (.{@extension}). Choose an audio file, or use Video tools or Photo tools.", "Audio tools")
            } else {
                const audioSizeBefore = fileDetailOf(@media, "File Size")
                @sizeBefore = "{audioSizeBefore}"
                @resultKind = "audio"
                if @tool == "Trim" {
                    @result = trimVideo(@media)
                }
                if @tool == "Convert" {
                    @audioFormats = list("M4A", "AIFF")
                    const audioFormatPicked = chooseFromList(@audioFormats, "Convert to")
                    @audioFormat = "{audioFormatPicked}"
                    showNotification("Converting…", "AnyDL", false)
                    if @audioFormat == "AIFF" {
                        @result = encodeAudio(@media, "AIFF")
                    } else {
                        @result = encodeAudio(@media, "M4A")
                    }
                }
                if @tool == "Change speed" {
                    @audioSpeeds = list("Half speed", "Double speed")
                    const audioSpeedPicked = chooseFromList(@audioSpeeds, "Change speed")
                    @audioSpeed = "{audioSpeedPicked}"
                    showNotification("Changing the speed…", "AnyDL", false)
                    if @audioSpeed == "Half speed" {
                        @result = encodeAudio(@media, "M4A", "0.5X")
                    } else {
                        @result = encodeAudio(@media, "M4A", "2X")
                    }
                }
            }
        }
    }

    /* The result of any tool: show the size change and what to do with it.
       Edit more keeps the result for the next tool. */
    if @result {
        const sizeAfterDetail = fileDetailOf(@result, "File Size")
        @sizeAfter = "{sizeAfterDetail}"
        if @resultKind == "audio" {
            menu "Done · {@sizeBefore} → {@sizeAfter}" {
                item "Preview":
                    quicklook(@result)
                item "Save to Files":
                    saveFilePrompt(@result)
                item "Share":
                    share(@result)
                item "Edit more":
                    @shared = @result
                    @sharedKind = "audio"
                    @view = "tools-audio"
            }
        } else {
            menu "Done · {@sizeBefore} → {@sizeAfter}" {
                item "Preview":
                    quicklook(@result)
                item "Save to Photos":
                    savePhoto(@result)
                    showNotification("Saved to Photos.", "AnyDL", false)
                item "Save to Files":
                    saveFilePrompt(@result)
                item "Share":
                    share(@result)
                item "Edit more":
                    @shared = @result
                    @sharedKind = @resultKind
                    if @resultKind == "video" {
                        @view = "tools-video"
                    } else {
                        @view = "tools-photo"
                    }
            }
        }
    }

    /* Facts about the AnyDL folder, read from a-Shell when first needed. */
    if @libraryLoaded == false {
        if @view == "library" || @view == "folders" || @view == "settings" || @view == "storage" {
            const libraryFile = aShellGet("anydl_library.txt", false, true)
            @libraryText = "{libraryFile}"
            const linkFound = matchText('shareddocuments://[^\n]+', "{@libraryText}")
            @libraryLink = getFirstItem(linkFound)
            const summaryFound = matchText('[0-9]+ files? · [^\n]+|No downloads yet', "{@libraryText}")
            @librarySummary = getFirstItem(summaryFound)
            if !@librarySummary {
                @librarySummary = "No downloads yet"
            }
            @signIn = "Not set up"
            if @libraryText contains "cookies.txt found" {
                @signIn = "cookies.txt found"
            }
            @libraryLoaded = true
        }
    }

    /* -------------------------------------------- My downloads. */
    if @view == "library" {
        @libraryItems: array
        @libraryItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Recent downloads\nORG:Download again or open the original link\nPHOTO;ENCODING=b:\nEND:VCARD"
        @libraryItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Browse folders\nORG:{@librarySummary}\nPHOTO;ENCODING=b:\nEND:VCARD"
        @libraryItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Back\nORG:To the main menu\nPHOTO;ENCODING=b:\nEND:VCARD"
        @libraryMenuText = "{@libraryItems}"
        @libraryMenuFile = setName(@libraryMenuText, "library.vcf", true)
        @libraryCards = @libraryMenuFile.contact
        const libraryChoice = chooseFromList(@libraryCards, "My downloads")
        @menuPick = "{libraryChoice}"
        @view = "home"
        if @menuPick == "Browse folders" {
            @view = "folders"
        }
        if @menuPick == "Recent downloads" {
            @view = "library"
            const historyFile = aShellGet("anydl_history.txt", false, true)
            @historyText = "{historyFile}"
            if !@historyText {
                alert("Nothing has been downloaded yet.", "Recent downloads")
            } else {
                const historyLines = splitText("{@historyText}", "\n")
                const historyPicked = chooseFromList(historyLines, "Recent downloads")
                @historyLine = "{historyPicked}"
                const numberFound = matchText('^[0-9]+', "{@historyLine}")
                const numberText = getFirstItem(numberFound)
                const historyNumber = number(numberText)
                menu "{@historyLine}" {
                    item "Download again":
                        aShellPut(scriptFile, true)
                        const againText = "again\n{numberText}\n{@settings}"
                        const againFile = setName(againText, "anydl_job.txt", true)
                        aShellPut(againFile, true)
                        aShellRun("cd $SHORTCUTS\npython anydl.py", "open", false)
                        stop()
                    item "Open the original link":
                        const linksFile = aShellGet("anydl_history_links.txt", false, true)
                        const historyLinks = splitText("{linksFile}", "\n")
                        const linkCount = count(historyLinks)
                        if historyNumber > linkCount {
                            alert("That link is no longer in the history.", "Recent downloads")
                        } else {
                            const originalLink = getListItem(historyLinks, historyNumber)
                            openURL("{originalLink}")
                            stop()
                        }
                    item "Back":
                        nothing()
                }
            }
        }
    }

    if @view == "folders" {
        if !@libraryLink {
            alert("Nothing has been downloaded yet. Your downloads will appear in Files › On My iPhone › a-Shell › AnyDL.", "My downloads")
            @view = "library"
        } else {
            @folderItems: array
            @folderItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:All downloads\nORG:{@librarySummary}\nPHOTO;ENCODING=b:\nEND:VCARD"
            @folderItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Videos\nORG:Downloaded videos\nPHOTO;ENCODING=b:\nEND:VCARD"
            @folderItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Audio\nORG:Music and sound\nPHOTO;ENCODING=b:\nEND:VCARD"
            @folderItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Photos\nORG:Images and photo posts\nPHOTO;ENCODING=b:\nEND:VCARD"
            @folderItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Files\nORG:Documents and other files\nPHOTO;ENCODING=b:\nEND:VCARD"
            @folderItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Playlists\nORG:One folder per playlist\nPHOTO;ENCODING=b:\nEND:VCARD"
            @folderItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Back\nORG:To My downloads\nPHOTO;ENCODING=b:\nEND:VCARD"
            @folderMenuText = "{@folderItems}"
            @folderMenuFile = setName(@folderMenuText, "folders.vcf", true)
            @folderCards = @folderMenuFile.contact
            const folderChoice = chooseFromList(@folderCards, "Open in Files")
            @menuPick = "{folderChoice}"
            @view = "library"
            if @menuPick == "All downloads" {
                openURL("{@libraryLink}")
                stop()
            }
            if @menuPick == "Videos" || @menuPick == "Audio" || @menuPick == "Photos" || @menuPick == "Files" || @menuPick == "Playlists" {
                openURL("{@libraryLink}/{@menuPick}")
                stop()
            }
        }
    }

    /* -------------------------------------------- Settings. */
    @settingsChanged = false
    if @view == "settings" {
        @settingItems: array
        @settingItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Downloads\nORG:{@quality} · {@fps} · {@audio} audio · subtitles {@subtitles}\nPHOTO;ENCODING=b:\nEND:VCARD"
        @settingItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:After download\nORG:{@after}\nPHOTO;ENCODING=b:\nEND:VCARD"
        @settingItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Storage\nORG:{@librarySummary} · keep {@keep}\nPHOTO;ENCODING=b:\nEND:VCARD"
        @settingItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:YouTube sign-in\nORG:{@signIn} · for the bot check\nPHOTO;ENCODING=b:\nEND:VCARD"
        @settingItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Updates\nORG:Automatic checks {@updates} · Check now\nPHOTO;ENCODING=b:\nEND:VCARD"
        @settingItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Help & about\nORG:AnyDL 3.3 · setup guide\nPHOTO;ENCODING=b:\nEND:VCARD"
        @settingItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Back\nORG:To the main menu\nPHOTO;ENCODING=b:\nEND:VCARD"
        @settingText = "{@settingItems}"
        @settingFile = setName(@settingText, "settings.vcf", true)
        @settingCards = @settingFile.contact
        const settingChoice = chooseFromList(@settingCards, "Settings")
        @setting = "{settingChoice}"
        if @setting == "Back" {
            @view = "home"
        }
        if @setting == "Downloads" {
            @view = "settings-downloads"
        }
        if @setting == "Storage" {
            @view = "storage"
        }
        if @setting == "After download" {
            @afterModes = list("Preview", "Save to Photos", "Keep in Files")
            @after = chooseFromList(@afterModes, "After download. Save to Photos works for photos and videos up to 50 MB; bigger ones open in a preview. Everything is also kept in Files.")
            @settingsChanged = true
        }
        if @setting == "YouTube sign-in" {
            menu "If YouTube keeps saying it thinks you are a bot, AnyDL can sign in with a cookies.txt from a browser where you are signed in to YouTube. Put the file in Files › a-Shell › AnyDL. Use a second Google account: YouTube may limit accounts used by downloaders." {
                item "How to get cookies.txt":
                    openURL("https://github.com/h4sw5q2wr9-byte/AnyDL#youtube-says-im-a-bot")
                    stop()
                item "Open the AnyDL folder":
                    if @libraryLink {
                        openURL("{@libraryLink}")
                        stop()
                    } else {
                        alert("The AnyDL folder appears after the first download.", "YouTube sign-in")
                    }
                item "Back":
                    nothing()
            }
        }
        if @setting == "Updates" {
            menu "Updates · you have AnyDL 3.3" {
                item "Check now":
                    const releaseData = downloadURL("https://api.github.com/repos/h4sw5q2wr9-byte/AnyDL/releases/latest")
                    const release = getDictionary(releaseData)
                    @latestTag = "{release['tag_name']}"
                    const tagFound = matchText('[0-9]+\.[0-9]+', "{@latestTag}")
                    const tagText = getFirstItem(tagFound)
                    if !tagText {
                        alert("Could not reach GitHub. Check your connection and try again.", "Updates")
                    } else {
                        const tagParts = splitText("{tagText}", ".")
                        const majorText = getFirstItem(tagParts)
                        const minorText = getLastItem(tagParts)
                        @latestNumber = number(majorText)
                        @latestNumber *= 1000
                        const minorNumber = number(minorText)
                        @latestNumber += minorNumber
                        @currentNumber = 3003
                        if @latestNumber > @currentNumber {
                            menu "AnyDL {tagText} is available (you have 3.3)" {
                                item "Update now":
                                    openURL("https://github.com/h4sw5q2wr9-byte/AnyDL/releases/latest")
                                    stop()
                                item "Later":
                                    nothing()
                            }
                        } else {
                            alert("You have the latest version, AnyDL 3.3.", "Updates")
                        }
                    }
                item "Automatic checks: On":
                    @updates = "On"
                    @settingsChanged = true
                item "Automatic checks: Off":
                    @updates = "Off"
                    @settingsChanged = true
            }
        }
        if @setting == "Help & about" {
            quicklook(welcomePage)
        }
    }

    if @view == "settings-downloads" {
        @downloadItems: array
        @downloadItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Video quality\nORG:{@quality}\nPHOTO;ENCODING=b:\nEND:VCARD"
        @downloadItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Frame rate\nORG:{@fps}\nPHOTO;ENCODING=b:\nEND:VCARD"
        @downloadItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Video format\nORG:{@codec}\nPHOTO;ENCODING=b:\nEND:VCARD"
        @downloadItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Audio format\nORG:{@audio}\nPHOTO;ENCODING=b:\nEND:VCARD"
        @downloadItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Subtitles\nORG:{@subtitles}\nPHOTO;ENCODING=b:\nEND:VCARD"
        @downloadItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Back\nORG:To Settings\nPHOTO;ENCODING=b:\nEND:VCARD"
        @downloadText = "{@downloadItems}"
        @downloadFile = setName(@downloadText, "download-settings.vcf", true)
        @downloadCards = @downloadFile.contact
        const downloadChoice = chooseFromList(@downloadCards, "Download settings")
        @setting = "{downloadChoice}"
        if @setting == "Back" {
            @view = "settings"
        }
        if @setting == "Video quality" {
            @qualities = list("Best", "4K (2160p)", "1440p", "1080p", "720p", "480p", "360p (Data saver)", "240p", "Ask each time")
            @quality = chooseFromList(@qualities, "Video quality. Upright and wide videos alike; if a video has no such size, the closest smaller one is used.")
            @settingsChanged = true
        }
        if @setting == "Frame rate" {
            @rates = list("Any", "Up to 60 fps", "Up to 30 fps")
            @fps = chooseFromList(@rates, "Frame rate. Lower frame rates make smaller files.")
            @settingsChanged = true
        }
        if @setting == "Video format" {
            @codecs = list("Most compatible", "Highest quality")
            @codec = chooseFromList(@codecs, "Most compatible: H.264, plays everywhere including Photos; YouTube offers it up to 1080p. Highest quality: also VP9 and AV1, needed for YouTube 1440p and 4K; may not play in every app.")
            @settingsChanged = true
        }
        if @setting == "Audio format" {
            @audioFormatChoices = list("Original", "MP3")
            @audio = chooseFromList(@audioFormatChoices, "Audio format. MP3 adds the cover image and title.")
            @settingsChanged = true
        }
        if @setting == "Subtitles" {
            @languages = list("Off", "English", "Dutch", "German", "French", "Spanish", "Portuguese", "Italian", "Polish", "Turkish", "Arabic", "Hindi", "Indonesian", "Japanese", "Korean", "Chinese")
            @subtitles = chooseFromList(@languages, "Subtitles built into downloaded videos. While a video plays, turn them on with the captions button. YouTube sometimes keeps them from downloaders; a-Shell says after each download whether they were added.")
            @settingsChanged = true
        }
    }

    if @view == "storage" {
        @storageItems: array
        @storageItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Keep downloads\nORG:{@keep}\nPHOTO;ENCODING=b:\nEND:VCARD"
        @storageItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Clear downloads\nORG:{@librarySummary}\nPHOTO;ENCODING=b:\nEND:VCARD"
        @storageItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Open AnyDL folder\nORG:In Files › a-Shell › AnyDL\nPHOTO;ENCODING=b:\nEND:VCARD"
        @storageItems += "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:Back\nORG:To Settings\nPHOTO;ENCODING=b:\nEND:VCARD"
        @storageText = "{@storageItems}"
        @storageFile = setName(@storageText, "storage.vcf", true)
        @storageCards = @storageFile.contact
        const storageChoice = chooseFromList(@storageCards, "Storage")
        @setting = "{storageChoice}"
        if @setting == "Back" {
            @view = "settings"
        }
        if @setting == "Keep downloads" {
            @keepModes = list("Forever", "1 month", "1 week", "1 day")
            @keep = chooseFromList(@keepModes, "Delete downloads from the AnyDL folder automatically after:")
            @settingsChanged = true
        }
        if @setting == "Open AnyDL folder" {
            if @libraryLink {
                openURL("{@libraryLink}")
                stop()
            } else {
                alert("The AnyDL folder appears after the first download.", "Storage")
            }
        }
        if @setting == "Clear downloads" {
            @clearWhat = ""
            menu "Clear downloads ({@librarySummary})" {
                item "Delete everything":
                    @clearWhat = "all"
                item "Delete downloads older than a week":
                    @clearWhat = "old"
                item "Cancel":
                    nothing()
            }
            if @clearWhat {
                aShellPut(scriptFile, true)
                const clearText = "clear\n{@clearWhat}"
                const clearFile = setName(clearText, "anydl_job.txt", true)
                aShellPut(clearFile, true)
                aShellRun("cd $SHORTCUTS\npython anydl.py", "open", false)
                stop()
            }
        }
    }

    /* Save settings only when one changed. */
    if @settingsChanged == true {
        @settings = "quality={@quality}\nfps={@fps}\ncodec={@codec}\naudio={@audio}\nsubtitles={@subtitles}\nafter={@after}\nkeep={@keep}\nupdates={@updates}"
        const newSettingsFile = setName(@settings, "anydl_settings.txt", true)
        aShellPut(newSettingsFile, true)
    }
}
